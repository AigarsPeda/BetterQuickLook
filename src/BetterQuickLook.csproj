<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BetterQuickLook</AssemblyName>
    <Version>1.0.5</Version>
    <ApplicationIcon>Assets\BetterQuickLook.ico</ApplicationIcon>
    <!-- Cache bundled assemblies on disk so Windows can map them, rather than
         retaining decompressed assembly copies in the tray process. -->
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="$(ApplicationIcon)" />
    <EmbeddedResource Include="Assets\Lucide-Zap-LICENSE.txt" />
  </ItemGroup>
</Project>
